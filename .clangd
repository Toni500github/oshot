CompileFlags:
  Add: [-Wall, -Wextra]
---
If:
  PathMatch: .*\.c$
CompileFlags:
  Remove: [-std=*]
  Add: [-xc, -std=c11]
---
If:
  PathMatch: .*\.h$
CompileFlags:
  Remove: [-std=*]
  Add: [-xc, -std=c11]
---
If:
  PathMatch: .*\.(cpp|cxx|cc|hpp|hxx|hh)$
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c++20]
