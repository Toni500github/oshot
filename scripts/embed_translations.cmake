# Embed the po/<code>.po catalogs into a C++ source file, read by src/i18n.cpp.
# Run in script mode: cmake -DPO_DIR=<dir> -DOUTPUT=<file> -P embed_translations.cmake
# Embedding them avoids a different install path per package (AppImage, .app, Flatpak, Windows).

file(GLOB PO_FILES "${PO_DIR}/*.po")
list(SORT PO_FILES)

set(content "// Generated by scripts/embed_translations.cmake from po/*.po, don't edit\n")
string(APPEND content "#include <cstddef>\n\n")
string(APPEND content "struct embedded_po_t\n{\n    const char* code;\n    const char* data;\n    std::size_t size;\n};\n\n")

set(entries "")
set(count 0)
foreach(po ${PO_FILES})
    get_filename_component(code "${po}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${code}" id)
    file(READ "${po}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Long lines are fine for compilers, but keep the file readable in a diff tool
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
    string(APPEND content "static const unsigned char po_${id}[] = {\n    ${bytes}0x00\n};\n\n")
    string(APPEND entries "    { \"${code}\", reinterpret_cast<const char*>(po_${id}), ${size} },\n")
    math(EXPR count "${count} + 1")
endforeach()

if(count EQUAL 0)
    set(entries "    { nullptr, nullptr, 0 },\n")
endif()

string(APPEND content "extern const embedded_po_t g_embedded_po[] = {\n${entries}};\n")
string(APPEND content "extern const std::size_t g_embedded_po_count = ${count};\n")

# Only rewrite on changes, so an unchanged catalog doesn't rebuild oshot_common
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
