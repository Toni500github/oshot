Checks: >
  -*,
  performance-*,
  bugprone-*,
  modernize-*,
  clang-analyzer-*,
  -modernize-use-trailing-return-type,
  -bugprone-reserved-identifier,
  -bugprone-easily-swappable-parameters,
  -modernize-avoid-c-style-cast,
  -bugprone-signed-bitwise,
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
# Generated image data, and the plugin ABI, which is C
ExcludeHeaderFilterRegex: '(tool_icons|oshot_png|tray_icon_png|oshot_plugin)\.h$'
