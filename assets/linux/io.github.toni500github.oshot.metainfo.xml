<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.toni500github.oshot</id>
  <name>oshot</name>
  <summary>Take a screenshot and extract its text on the fly</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause</project_license>
  <developer id="io.github.toni500github">
    <name>Toni500</name>
  </developer>
  <description>
    <p>
      oshot is a lightweight screenshot overlay: select a region of the screen
      and extract its text with Tesseract OCR, decode QR codes and barcodes with
      ZBar, annotate it, then copy or save it.
    </p>
    <p>Features:</p>
    <ul>
      <li>Text extraction (OCR) in any language Tesseract has a model for</li>
      <li>QR code and barcode scanning</li>
      <li>Annotations: arrows, lines, rectangles, circles, numbered counters, text and freehand drawing</li>
      <li>Works on X11 and Wayland, with multiple monitors</li>
      <li>Optional system tray mode</li>
    </ul>
  </description>
  <launchable type="desktop-id">oshot.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Extract the text of a selection with OCR</caption>
      <image>https://raw.githubusercontent.com/Toni500github/oshot/main/assets/screenshots/ocr.png</image>
    </screenshot>
    <screenshot>
      <caption>Decode QR codes and barcodes</caption>
      <image>https://raw.githubusercontent.com/Toni500github/oshot/main/assets/screenshots/qr-barcode.png</image>
    </screenshot>
    <screenshot>
      <caption>Annotate the selection before copying or saving it</caption>
      <image>https://raw.githubusercontent.com/Toni500github/oshot/main/assets/screenshots/annotations.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#8f9cff</color>
    <color type="primary" scheme_preference="dark">#1a1a8c</color>
  </branding>
  <provides>
    <binary>oshot</binary>
  </provides>
  <url type="homepage">https://github.com/Toni500github/oshot</url>
  <url type="bugtracker">https://github.com/Toni500github/oshot/issues</url>
  <url type="vcs-browser">https://github.com/Toni500github/oshot</url>
  <categories>
