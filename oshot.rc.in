#include <winver.h>

IDI_ICON1 ICON "@OSHOT_ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Toni500"
            VALUE "FileDescription",  "oshot - screenshot text extractor"
            VALUE "FileVersion",      "@PROJECT_FULL_VERSION@"
            VALUE "InternalName",     "oshot"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 Toni500, BSD-3-Clause"
            VALUE "OriginalFilename", "oshot.exe"
            VALUE "ProductName",      "oshot"
            VALUE "ProductVersion",   "@PROJECT_FULL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
